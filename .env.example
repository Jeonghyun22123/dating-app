# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 포함되어 누구나 볼 수 있습니다.
# service_role 키, Toss 시크릿 키, OpenAI/Sightengine 키는 절대 여기에 넣지 말고
# Supabase Edge Function 시크릿으로만 관리하세요.

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# PostHog > Project Settings (비워두면 분석이 꺼집니다)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
