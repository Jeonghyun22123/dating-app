# Edge Function 시크릿 목록. 실제 값은 git 에 올리지 말고 아래 둘 중 하나로 등록하세요.
#   - 대시보드: Edge Functions > Secrets
#   - CLI: supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는 Supabase 가 자동으로 넣어주므로
# 직접 등록하지 않습니다.

# ---- Sightengine (moderate-photo) ----
# 둘 다 비어 있으면 "테스트 모드": 실제 검수 없이 모든 사진을 통과 처리합니다.
# 정식 출시 전에는 반드시 값을 넣으세요. https://dashboard.sightengine.com > API Credentials
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# 거절 기준 (0~1, 값이 낮을수록 엄격). 비워두면 아래 기본값을 사용합니다.
MODERATION_NUDITY_THRESHOLD=0.5
MODERATION_AI_GENERATED_THRESHOLD=0.85
MODERATION_OFFENSIVE_THRESHOLD=0.6

# true 이면 셀카가 검수를 통과하는 즉시 인증 완료(approved) 처리하고 셀카를 바로 삭제합니다.
# false(기본값) 이면 '심사 중' 상태로 두고 관리자가 수동 승인합니다 (관리자 페이지는 이후 Phase).
# 얼굴 일치 비교가 아직 없으므로 운영 환경에서는 false 로 두는 것을 권장합니다.
SELFIE_AUTO_APPROVE=false

# ---- OpenAI (update-profile-embedding) ----
# 비어 있으면 임베딩 생성을 조용히 건너뜁니다 (에러 아님).
OPENAI_API_KEY=
